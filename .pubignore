# What NOT to ship to pub.dev.
#
# pub uses this file INSTEAD of .gitignore when packaging, so it has to
# repeat the entries that matter rather than only adding to them.

# Build output and tooling
build/
.dart_tool/
.idea/
pubspec.lock

# Local-only folders
test/
.agents/
.codex/
.fvm/
.claude/

# The website: a Flutter demo app and a static-site generator. Sources for
# the docs site, not part of the package — and the Flutter web build alone
# is tens of megabytes.
web_demos/
docs_site/
